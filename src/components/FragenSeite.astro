---
import { FRAGEN } from '../lib/fragen';
import { PFADE, t, type Sprache } from '../lib/i18n';

interface Props {
  sprache: Sprache;
}
const { sprache } = Astro.props;
const de = sprache === 'de';
const T = de
  ? {
      titel: 'Häufige Fragen zum Schuldschein',
      lead: 'Kurze Antworten. Wo es um das Gesetz geht, steht darunter, worauf die Antwort beruht.',
      haftung: 'Im Zweifel frag eine Anwältin oder einen Anwalt, bei Steuern eine Steuerberatung.',
      grundlage: 'Grundlage: ',
      mehr: 'Weitere Fragen zur Rechtslage',
      mehrText: 'Die ganze Rechtslage mit Gesetz und Urteilen steht auf einer Seite.',
      zur: 'Zur Rechtslage',
    }
  : {
      titel: 'Frequently asked questions about promissory notes',
      lead: 'Short answers. Where the law is involved, the basis for the answer is given below it.',
      haftung: 'If in doubt, ask a lawyer, or a tax adviser for tax questions.',
      grundlage: 'Basis: ',
      mehr: 'More about the law',
      mehrText: 'The full legal picture with statutes and court decisions is on one page.',
      zur: 'Go to the law page',
    };
const gruppen = FRAGEN[sprache];
// Strukturierte Daten aus demselben Inhalt wie die sichtbaren Antworten
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: gruppen.flatMap((gr) => gr.fragen.map((f) => ({
    '@type': 'Question',
    name: f.frage,
    acceptedAnswer: { '@type': 'Answer', text: f.antwort },
  }))),
};
const ziel = (seite: keyof typeof PFADE, anker?: string) => `${PFADE[seite][sprache]}${anker ? `#${anker}` : ''}`;
---
<script type="application/ld+json" set:html={JSON.stringify(faq)} />
<h1 class="seite-titel">{T.titel}</h1>
<p class="lead">{T.lead}</p>
<div class="haftung" role="note"><b>{t(sprache, 'haftung.kurz').split('.')[0]}.</b> <span>{T.haftung}</span></div>

<div class="gruppen">
  {gruppen.map((gr, i) => (
    <section class="gruppe" aria-labelledby={`g${i}`}>
      <h2 id={`g${i}`}>{gr.titel}</h2>
      {gr.fragen.map((f) => (
        <details class="frage">
          <summary>{f.frage}</summary>
          <div class="antwort">
            <p>{f.antwort}</p>
            {(f.grundlage || f.link) && (
              <p class="grundlage">
                {f.grundlage && <>{T.grundlage}{f.grundlage}</>}
                {f.grundlage && f.link && ' '}
                {f.link && <a href={ziel(f.link.seite, f.link.anker)}>{f.link.text}</a>}
              </p>
            )}
          </div>
        </details>
      ))}
    </section>
  ))}
</div>

<div class="hinweis-rot">
  <p><b>{T.mehr}</b>{T.mehrText}</p>
  <a class="knopf" href={PFADE.rechtslage[sprache]}>{T.zur}</a>
</div>

