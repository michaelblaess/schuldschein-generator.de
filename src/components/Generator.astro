---
import Dokument from './Dokument.astro';
import { BASISZINS } from '../lib/basiszins';
import { PFADE, t, type Sprache } from '../lib/i18n';
import { GT } from '../lib/texte-generator';
import { erzeugeVertrag, leereAngaben } from '../lib/vertrag';

interface Props {
  sprache: Sprache;
}
const { sprache } = Astro.props;
const g = GT[sprache];
const verzug = BASISZINS.verzug.toLocaleString(sprache === 'de' ? 'de-DE' : 'en-GB');
const start = erzeugeVertrag(leereAngaben(), 'kompakt', sprache);
---
<p class="vorzeile nicht-drucken">{g.claim}</p>
<h1 class="seite-titel nicht-drucken">{g.titel}</h1>
<p class="lead nicht-drucken"><span class="zeile">{g.lead}</span> <span class="zeile">{g.leadZwei}</span></p>
<div class="haftung gross nicht-drucken" role="note">
  <b>{t(sprache, 'haftung.kurz')}</b>
  <span>{t(sprache, 'haftung.lang')}</span>
</div>

<div class="arbeit" id="generator" data-sprache={sprache}>
  <div class="eingabe nicht-drucken">
    <form class="beleg" id="beleg" aria-label={g.kopfLinks} novalidate>
      <div class="kopfzeile" aria-hidden="true"><span>{g.kopfLinks}</span><span>{g.kopfRechts}</span></div>
      <div class="personen">
        <fieldset class="person-block">
          <legend>{g.geberName}</legend>
          <div class="feld">
            <label for="geber_name">{g.name}</label>
            <input id="geber_name" name="geber_name" data-pflicht required autocomplete="off" />
          </div>
          <div class="feld">
            <label for="geber_adresse">{g.anschrift}</label>
            <input id="geber_adresse" name="geber_adresse" data-pflicht required autocomplete="off" placeholder={g.anschriftHinweis} />
          </div>
          <div class="reihe eng">
            <div class="feld"><label for="geber_geburt">{g.geburt}<span class="klein">{g.freiwillig}</span></label><input id="geber_geburt" name="geber_geburt" type="date" /></div>
            <div class="feld"><label for="geber_ausweis">{g.ausweis}<span class="klein">{g.freiwillig}</span></label><input id="geber_ausweis" name="geber_ausweis" maxlength="12" autocomplete="off" autocapitalize="characters" spellcheck="false" /></div>
          </div>
        </fieldset>
        <fieldset class="person-block">
          <legend>{g.nehmerName}</legend>
          <div class="feld">
            <label for="nehmer_name">{g.name}</label>
            <input id="nehmer_name" name="nehmer_name" data-pflicht required autocomplete="off" />
          </div>
          <div class="feld">
            <label for="nehmer_adresse">{g.anschrift}</label>
            <input id="nehmer_adresse" name="nehmer_adresse" data-pflicht required autocomplete="off" placeholder={g.anschriftHinweis} />
          </div>
          <div class="reihe eng">
            <div class="feld"><label for="nehmer_geburt">{g.geburt}</label><input id="nehmer_geburt" name="nehmer_geburt" type="date" data-pflicht required /></div>
            <div class="feld"><label for="nehmer_ausweis">{g.ausweis}</label><input id="nehmer_ausweis" name="nehmer_ausweis" maxlength="12" data-pflicht required autocomplete="off" autocapitalize="characters" spellcheck="false" aria-describedby="nehmer-hinweis" /></div>
          </div>
          <p class="hilfe" id="nehmer-hinweis">{g.nehmerHinweis}</p>
        </fieldset>
      </div>
      <div class="reihe">
        <div class="feld">
          <label for="summe">{g.betrag}</label>
          <div class="betrag">
            <input id="summe" name="summe" data-pflicht required inputmode="decimal" maxlength="10" autocomplete="off" aria-describedby="summe-worte summe-fehler" />
            <span aria-hidden="true">EUR</span>
          </div>
          <div class="hilfe" id="summe-worte" aria-live="polite"></div>
          <div class="fehler" id="summe-fehler" hidden></div>
        </div>
        <div class="feld">
          <label for="zurueck">{g.zurueck}</label>
          <input id="zurueck" name="zurueck" type="date" data-pflicht required aria-describedby="zurueck-fehler" />
          <div class="fehler" id="zurueck-fehler" hidden></div>
          <label class="merken" style="margin-top:8px;color:inherit;font-weight:500">
            <input type="checkbox" id="unbefristet" name="unbefristet" />
            <span>{g.unbefristet}</span>
          </label>
        </div>
      </div>
      <div class="feld">
        <span class="label" id="l-aus">{g.auszahlung}</span>
        <div class="wahl" role="radiogroup" aria-labelledby="l-aus">
          <label><input type="radio" name="auszahlung" value="bar" checked /><span>{g.bar}</span></label>
          <label><input type="radio" name="auszahlung" value="ueberweisung" /><span>{g.ueberweisung}</span></label>
          <label><input type="radio" name="auszahlung" value="anders" /><span>{g.anders}</span></label>
        </div>
      </div>
    </form>

    <p class="zwischen">{g.zwischen}</p>

    <details class="streifen">
      <summary><b>{g.zinsen}</b><em data-zusammenfassung="zinsen">{g.zinslos}</em></summary>
      <div class="innen-streifen">
        <div class="feld">
          <label for="zinssatz">{g.zinssatz}</label>
          <input id="zinssatz" name="zinssatz" form="beleg" inputmode="decimal" autocomplete="off" placeholder={g.zinsHinweis} aria-describedby="zinssatz-fehler" />
          <div class="fehler" id="zinssatz-fehler" hidden></div>
        </div>
        <p class="hilfe">{g.verzugVor}{verzug}{g.verzugNach} <a href={`${PFADE.rechtslage[sprache]}#zinsen`}>{g.warum}</a></p>
      </div>
    </details>

    <details class="streifen">
      <summary><b>{g.raten}</b><em data-zusammenfassung="raten">{g.einmal}</em></summary>
      <div class="innen-streifen">
        <div class="reihe">
          <div class="feld">
            <label for="rhythmus">{g.rhythmus}</label>
            <select id="rhythmus" name="rhythmus" form="beleg">
              <option value="einmal">{g.einmal}</option>
              <option value="monatlich">{g.monatlich}</option>
              <option value="vierteljaehrlich">{g.vierteljaehrlich}</option>
            </select>
          </div>
          <div class="feld">
            <label for="erste">{g.ersteRate}</label>
            <input id="erste" name="erste" type="date" form="beleg" aria-describedby="erste-fehler" />
            <div class="fehler" id="erste-fehler" hidden></div>
          </div>
        </div>
        <p class="hilfe">{g.ratenHinweis}</p>
      </div>
    </details>


    <details class="streifen">
      <summary><b>{g.bank}</b><em data-zusammenfassung="bank">{g.nichtAngegeben}</em></summary>
      <div class="innen-streifen">
        <div class="reihe">
          <div class="feld">
            <label for="geber_iban">{g.ibanGeber}</label>
            <input id="geber_iban" name="geber_iban" form="beleg" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={g.ibanHinweis} aria-describedby="geber_iban-fehler" />
            <div class="fehler" id="geber_iban-fehler" hidden></div>
          </div>
          <div class="feld">
            <label for="nehmer_iban">{g.ibanNehmer}</label>
            <input id="nehmer_iban" name="nehmer_iban" form="beleg" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={g.ibanHinweis} aria-describedby="nehmer_iban-fehler" />
            <div class="fehler" id="nehmer_iban-fehler" hidden></div>
          </div>
        </div>
      </div>
    </details>

    <details class="streifen">
      <summary><b>{g.zweck}</b><em data-zusammenfassung="zweck">{g.nichtAngegeben}</em></summary>
      <div class="innen-streifen">
        <div class="feld"><label for="zweck">{g.zweckFeld}</label><textarea id="zweck" name="zweck" form="beleg" maxlength="300" placeholder={g.zweckHinweis}></textarea></div>
      </div>
    </details>

    <details class="streifen">
      <summary><b>{g.zeuge}</b><em data-zusammenfassung="zeuge">{g.keine}</em></summary>
      <div class="innen-streifen">
        <div class="reihe">
          <div class="feld"><label for="zeuge_name">{g.name}</label><input id="zeuge_name" name="zeuge_name" form="beleg" autocomplete="off" /></div>
          <div class="feld"><label for="zeuge_adresse">{g.anschrift}</label><input id="zeuge_adresse" name="zeuge_adresse" form="beleg" autocomplete="off" placeholder={g.anschriftHinweis} /></div>
        </div>
        <div class="reihe">
          <div class="feld"><label for="zeuge_geburt">{g.geburt}</label><input id="zeuge_geburt" name="zeuge_geburt" type="date" form="beleg" /></div>
          <div class="feld"><label for="zeuge_ausweis">{g.ausweis}</label><input id="zeuge_ausweis" name="zeuge_ausweis" maxlength="12" form="beleg" autocomplete="off" autocapitalize="characters" spellcheck="false" /></div>
        </div>
        <p class="hilfe">{g.zeugeHinweis}</p>
      </div>
    </details>

    <label class="merken">
      <input type="checkbox" id="merken" />
      <span>{g.merken}<br /><small class="hilfe" style="display:inline">{g.merkenHinweis}</small></span>
    </label>
    <button class="knopf-text" type="button" id="leeren">{g.leeren}</button>
  </div>

  <div class="ausgabe">
    <section class="vorschau" aria-labelledby="h-vorschau">
      <div class="vorschau-kopf nicht-drucken">
        <h2 id="h-vorschau">{g.vorschau}</h2>
        <div class="wahl fassung" role="radiogroup" aria-label={g.fassung}>
          <label><input type="radio" name="fassung" value="kompakt" checked /><span>{g.kompakt}</span></label>
          <label><input type="radio" name="fassung" value="ausfuehrlich" /><span>{g.ausfuehrlich}</span></label>
        </div>
      </div>
      <div id="dokument" aria-live="off">
        <Dokument bausteine={start} modus="generator" />
      </div>
      <p class="hilfe nicht-drucken" style="margin-top:12px">{g.unterschreiben}</p>
    </section>
  </div>
</div>

<div class="leiste nicht-drucken">
  <div class="innen rahmen-breite">
    <div class="stand-text">
      <div class="stand-zeile">
        <div class="fortschritt" id="fortschritt" role="progressbar" aria-valuemin="0" aria-label={g.fortschritt}></div>
        <b id="stand-titel" aria-live="polite"></b>
      </div>
      <span id="stand-text"></span>
    </div>
    <button class="knopf zwei" type="button" id="drucken">{g.drucken}</button>
    <button class="knopf" type="button" id="pdf" data-text={g.pdf} data-laeuft={g.pdfLaeuft}>{g.pdf}</button>
  </div>
</div>

<script>
  import { starteGenerator } from '../scripts/generator';
  starteGenerator();
</script>
